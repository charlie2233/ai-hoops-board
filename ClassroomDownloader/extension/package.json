{
  "name": "coursebinder-ai-ready-google-classroom-exporter",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:native": "COURSEBINDER_ENABLE_NATIVE=1 wxt build",
    "smoke:fixture": "node scripts/smoke-fixture.mjs",
    "smoke:zip": "node scripts/smoke-packaged-zip.mjs",
    "test": "vitest run",
    "zip": "wxt zip",
    "zip:native": "COURSEBINDER_ENABLE_NATIVE=1 wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.0.0",
    "playwright": "^1.61.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0",
    "wxt": "^0.20.0"
  }
}
